<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Orbit</vendor>
  <vendor_url>https://github.com/atasoglu/orbit</vendor_url>
  <action id="io.github.atasoglu.orbit.scan">
    <description>Scan the whole disk</description>
    <message>Authentication is required to scan files that only administrators can read</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/orbit/orbit-scan-helper</annotate>
  </action>
</policyconfig>
