import { Palette, ListView } from "std-widgets.slint";

export struct Item { name: string, size: string }
export struct LargeItem { name: string, dir: string, size: string, age: string, can-trash: bool }
export struct DiskItem { device: string, mount: string, fstype: string, used: string, free: string, total: string, percent: string, fraction: float }
export struct CleanItem { title: string, desc: string, size: string, risk: string, checked: bool, admin: bool, command: string }
export { Palette, Theme }

// Theme tokens. Auto = follow the system (Palette.color-scheme is the live value).
global Theme {
    in-out property <string> mode: "auto"; // "auto" | "light" | "dark"
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> window-bg: dark ? #1c1c1e : #f5f5f7;
    out property <color> sidebar-bg: dark ? #252528 : #ebebee;
    out property <color> panel-bg: dark ? #2c2c2e : #ffffff;
    out property <color> border: dark ? #3a3a3c : #d8d8dc;
    out property <color> text: dark ? #f2f2f7 : #1d1d1f;
    out property <color> text-dim: dark ? #98989f : #6e6e73;
    out property <color> accent: #0a84ff;
    out property <color> segment-bg: dark ? #3a3a3c : #dcdce0;
}

component Segment inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 26px;
    border-radius: 7px;
    background: active ? Theme.panel-bg : transparent;
    drop-shadow-blur: active ? 2px : 0px;
    drop-shadow-color: #0000002a;
    drop-shadow-offset-y: 1px;
    Text { text: label; font-size: 12px; color: active ? Theme.text : Theme.text-dim; }
    TouchArea { clicked => { root.clicked(); } }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 32px;
    border-radius: 7px;
    background: active ? Theme.accent : (ta.has-hover ? Theme.segment-bg : transparent);
    ta := TouchArea { clicked => { root.clicked(); } }
    Text {
        x: 12px;
        text: label;
        font-size: 13px;
        color: active ? white : Theme.text;
        vertical-alignment: center;
    }
}


component Pill inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    in property <length> w: 64px;
    height: 18px;
    width: w;
    border-radius: 9px;
    background: tint.with-alpha(0.18);
    t := Text { text: label; font-size: 10px; font-weight: 600; color: tint; horizontal-alignment: center; vertical-alignment: center; }
}

component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 30px;
    width: t.preferred-width + 28px;
    border-radius: 8px;
    opacity: enabled ? 1 : 0.4;
    background: primary ? Theme.accent : Theme.segment-bg;
    t := Text { text: label; font-size: 12px; color: primary ? white : Theme.text; }
    TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component LargePage inherits Rectangle {
    in property <[LargeItem]> items;
    in property <string> msg;
    callback show(int);
    callback trash(int);
    background: Theme.panel-bg;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            Text { text: "The biggest files on this disk"; font-size: 15px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.msg; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
        }
        // Column headers share the row's fixed widths.
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 12px;
            Text { text: "NAME"; font-size: 10px; color: Theme.text-dim; horizontal-stretch: 1; }
            Text { text: "MODIFIED"; font-size: 10px; color: Theme.text-dim; width: 80px; }
            Text { text: "SIZE"; font-size: 10px; color: Theme.text-dim; width: 84px; horizontal-alignment: right; }
            Rectangle { width: 156px; }
        }
        ListView {
            vertical-stretch: 1;
            for it[i] in root.items: Rectangle {
                height: 52px;
                border-radius: 8px;
                background: ta.has-hover ? Theme.window-bg : transparent;
                ta := TouchArea { }
                HorizontalLayout {
                    padding: 10px;
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text { text: it.name; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
                        Text { text: it.dir; font-size: 11px; color: Theme.text-dim; overflow: elide; }
                    }
                    Text { width: 80px; text: it.age; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                    Text { width: 84px; text: it.size; font-size: 13px; font-weight: 600; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
                    Rectangle {
                        width: 72px;
                        Btn { label: "Show"; x: 0px; y: (parent.height - self.height) / 2; clicked => { root.show(i); } }
                    }
                    Rectangle {
                        width: 72px;
                        if it.can-trash: Btn { label: "Trash"; x: 0px; y: (parent.height - self.height) / 2; clicked => { root.trash(i); } }
                    }
                }
            }
        }
    }
}

component DisksPage inherits Rectangle {
    in property <[DiskItem]> items;
    background: Theme.panel-bg;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;

    function bar-color(f: float) -> color {
        f > 0.9 ? #ff453a : (f > 0.75 ? #ff9f0a : #30d158)
    }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Text { text: "Disks in this system"; font-size: 15px; font-weight: 600; color: Theme.text; }
        ListView {
            vertical-stretch: 1;
            for it in root.items: Rectangle {
                height: 78px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: it.mount; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; vertical-alignment: center; }
                        Text { text: "\{it.device} · \{it.fstype}"; font-size: 11px; color: Theme.text-dim; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: it.percent; font-size: 13px; font-weight: 700; color: root.bar-color(it.fraction); vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 10px;
                        border-radius: 5px;
                        background: Theme.segment-bg;
                        Rectangle {
                            x: 0px;
                            width: parent.width * it.fraction;
                            border-radius: 5px;
                            background: root.bar-color(it.fraction);
                        }
                    }
                    Text { text: "\{it.used} used · \{it.free} free · \{it.total} total"; font-size: 11px; color: Theme.text-dim; }
                }
            }
        }
    }
}

component CleanupPage inherits Rectangle {
    in property <[CleanItem]> items;
    in property <string> total;
    in property <string> selected;
    in property <int> count;
    in property <string> mode;
    in property <bool> busy;
    in property <string> msg;
    in-out property <bool> confirm-open: false;
    callback toggle(int);
    callback set-mode(string);
    callback select-safe();
    callback run();

    background: Theme.panel-bg;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;

    function risk-color(r: string) -> color {
        r == "safe" ? #30d158 : (r == "review" ? #ff9f0a : #ff453a)
    }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            Text { text: root.total; font-size: 15px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Btn { label: "Select safe items"; clicked => { root.select-safe(); } }
        }
        ListView {
            vertical-stretch: 1;
            for it[i] in root.items: Rectangle {
                height: it.admin ? 96px : 62px;
                border-radius: 8px;
                background: ta.has-hover ? Theme.window-bg : transparent;
                ta := TouchArea { clicked => { root.toggle(i); } }
                HorizontalLayout {
                    padding: 10px;
                    spacing: 12px;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 6px;
                        background: it.checked ? Theme.accent : transparent;
                        border-width: it.checked ? 0px : 1.5px;
                        border-color: Theme.text-dim;
                        Text { text: it.checked ? "✓" : ""; color: white; font-size: 13px; font-weight: 700; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: it.title; font-size: 13px; font-weight: 600; color: Theme.text; overflow: elide; }
                        Text { text: it.desc; font-size: 11px; color: Theme.text-dim; overflow: elide; }
                        if it.admin: Text { text: "Runs with admin rights (system password prompt):"; font-size: 11px; color: Theme.text-dim; }
                        if it.admin: TextInput {
                            text: it.command;
                            read-only: true;
                            font-size: 11px;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                    }
                    // Fixed-width columns so every row lines up exactly.
                    Rectangle {
                        width: 52px;
                        if it.admin: Pill { w: 52px; label: "admin"; tint: #5e5ce6; y: (parent.height - self.height) / 2; }
                    }
                    Rectangle {
                        width: 64px;
                        Pill { w: 64px; label: it.risk; tint: root.risk-color(it.risk); y: (parent.height - self.height) / 2; }
                    }
                    Text {
                        width: 84px;
                        text: it.size;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                height: 30px;
                width: 230px;
                border-radius: 9px;
                background: Theme.segment-bg;
                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    Segment { label: "Move to Trash"; active: root.mode == "trash"; clicked => { root.set-mode("trash"); } }
                    Segment { label: "Delete permanently"; active: root.mode == "delete"; clicked => { root.set-mode("delete"); } }
                }
            }
            Text { text: root.msg; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            Text { text: root.selected; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
            Btn { label: root.busy ? "Cleaning…" : "Clean up"; primary: true; enabled: root.count > 0 && !root.busy; clicked => { root.confirm-open = true; } }
        }
    }

    if root.confirm-open: Rectangle {
        background: #00000066;
        border-radius: 12px;
        TouchArea { }
        Rectangle {
            width: 340px;
            height: 190px;
            border-radius: 14px;
            background: Theme.panel-bg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text { text: root.mode == "delete" ? "Delete permanently?" : "Move to Trash?"; font-size: 16px; font-weight: 700; color: Theme.text; }
                Text {
                    text: root.mode == "delete" ? "\{root.selected} will be removed right away. This cannot be undone. Admin items ask for your password." : "\{root.selected} will be moved to the Trash. Space is freed once the Trash is emptied. Admin items ask for your password and are removed for good.";
                    font-size: 12px;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Btn { label: "Cancel"; clicked => { root.confirm-open = false; } }
                    Btn { label: root.mode == "delete" ? "Delete" : "Move to Trash"; primary: true; clicked => { root.confirm-open = false; root.run(); } }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Orbit";
    icon: @image-url("../../../assets/icons/png/orbit-256.png");
    min-width: 760px;
    min-height: 520px;
    preferred-width: 1000px;
    preferred-height: 680px;
    background: Theme.window-bg;
    default-font-family: "Inter";

    in property <image> chart;
    in property <string> status: "Scanning…";
    in property <string> crumb: "/";
    in property <string> sel-name: "";
    in property <string> sel-size: "";
    in property <string> sel-share: "";
    in property <string> sel-files: "";
    in property <string> total: "";
    in property <string> theme-mode: "auto";
    in-out property <string> page: "overview";
    in property <bool> has-selection: false;
    in property <string> sel-title: "HOVER";
    in property <bool> can-zoom: false;
    out property <length> chart-size: min(chart-area.width, chart-area.height);
    in property <[Item]> items;
    in property <bool> admin-available: false;
    in property <bool> admin-scan: false;
    in property <bool> scanning: false;
    out property <bool> is-dark: Theme.dark;
    callback theme-changed();
    changed is-dark => { root.theme-changed(); }
    callback scan-admin();
    in property <[DiskItem]> disk-items;
    in property <[LargeItem]> large-items;
    in property <string> large-msg;
    callback large-show(int);
    callback large-trash(int);
    in property <[CleanItem]> clean-items;
    in property <string> clean-total: "Analysing…";
    in property <string> clean-selected;
    in property <int> clean-count;
    in property <string> clean-mode: "trash";
    in property <bool> clean-busy;
    in property <string> clean-msg;
    callback clean-toggle(int);
    callback clean-set-mode(string);
    callback clean-select-safe();
    callback clean-run();
    callback item-clicked(int);
    callback item-hovered(int);
    callback go-root();
    callback zoom-in();
    callback double-clicked(length, length);

    callback hover(length, length);
    callback clicked(length, length);
    callback go-up();
    callback set-theme(string);
    callback chart-resized();

    HorizontalLayout {
        // Sidebar
        Rectangle {
            width: 210px;
            background: Theme.sidebar-bg;
            VerticalLayout {
                padding: 16px;
                spacing: 4px;
                Text { text: "Orbit"; font-size: 17px; font-weight: 700; color: Theme.text; }
                Rectangle { height: 12px; }
                NavItem { label: "Overview"; active: root.page == "overview"; clicked => { root.page = "overview"; } }
                NavItem { label: "Disks"; active: root.page == "disks"; clicked => { root.page = "disks"; } }
                NavItem { label: "Cleanup"; active: root.page == "cleanup"; clicked => { root.page = "cleanup"; } }
                NavItem { label: "Large files"; active: root.page == "large"; clicked => { root.page = "large"; } }
                Rectangle { vertical-stretch: 1; }
                Text { text: "Appearance"; font-size: 11px; color: Theme.text-dim; }
                Rectangle {
                    height: 30px;
                    border-radius: 9px;
                    background: Theme.segment-bg;
                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        Segment { label: "Auto"; active: root.theme-mode == "auto"; clicked => { root.set-theme("auto"); } }
                        Segment { label: "Light"; active: root.theme-mode == "light"; clicked => { root.set-theme("light"); } }
                        Segment { label: "Dark"; active: root.theme-mode == "dark"; clicked => { root.set-theme("dark"); } }
                    }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }

        // Main
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                Text { text: root.page == "overview" ? "Overview" : (root.page == "disks" ? "Disks" : (root.page == "cleanup" ? "Cleanup" : "Large files")); font-size: 22px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.status; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
                if root.admin-available && !root.admin-scan && !root.scanning: Btn { label: "Scan as admin"; clicked => { root.scan-admin(); } }
            }
            Rectangle {
                vertical-stretch: 1;
                if root.page == "large": LargePage {
                width: parent.width;
                height: parent.height;
                items: root.large-items;
                msg: root.large-msg;
                show(i) => { root.large-show(i); }
                trash(i) => { root.large-trash(i); }
            }
            if root.page == "disks": DisksPage {
                width: parent.width;
                height: parent.height;
                items: root.disk-items;
            }
            if root.page == "cleanup": CleanupPage {
                width: parent.width;
                height: parent.height;
                items: root.clean-items;
                total: root.clean-total;
                selected: root.clean-selected;
                count: root.clean-count;
                mode: root.clean-mode;
                busy: root.clean-busy;
                msg: root.clean-msg;
                toggle(i) => { root.clean-toggle(i); }
                set-mode(m) => { root.clean-set-mode(m); }
                select-safe => { root.clean-select-safe(); }
                run => { root.clean-run(); }
            }
            row := Rectangle {
                width: parent.width;
                height: parent.height;
                visible: root.page == "overview";
                HorizontalLayout {
                spacing: 12px;
                chart-area := Rectangle {
                    horizontal-stretch: 1;
                    min-width: 200px;
                    min-height: 200px;
                    preferred-width: 200px;
                    preferred-height: 200px;
                    background: Theme.panel-bg;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border;
                    changed width => { root.chart-resized(); }
                    changed height => { root.chart-resized(); }
                    Image {
                        x: (chart-area.width - self.width) / 2;
                        y: (chart-area.height - self.height) / 2;
                        width: root.chart-size - 24px;
                        height: root.chart-size - 24px;
                        source: root.chart;
                        image-fit: contain;
                    }
                    TouchArea {
                        x: (chart-area.width - self.width) / 2;
                        y: (chart-area.height - self.height) / 2;
                        width: root.chart-size - 24px;
                        height: root.chart-size - 24px;
                        moved => { root.hover(self.mouse-x, self.mouse-y); }
                        clicked => { root.clicked(self.mouse-x, self.mouse-y); }
                        double-clicked => { root.double-clicked(self.mouse-x, self.mouse-y); }
                    }
                }
                // Inspector
                Rectangle {
                    width: 230px;
                    background: Theme.panel-bg;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        Text { text: "PATH"; font-size: 10px; color: Theme.text-dim; }
                        Text { text: root.crumb; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                        Rectangle { height: 8px; }
                        Text { text: root.sel-title; font-size: 10px; color: Theme.text-dim; }
                        Text { text: root.sel-name; font-size: 15px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                        Text { text: root.sel-size; font-size: 22px; font-weight: 700; color: Theme.accent; }
                        Text { text: root.sel-share; font-size: 12px; color: Theme.text-dim; }
                        Text { text: root.sel-files; font-size: 12px; color: Theme.text-dim; }
                        Rectangle { height: 8px; }
                        if root.can-zoom: Rectangle {
                            height: 30px;
                            border-radius: 8px;
                            background: Theme.accent;
                            Text { text: "Zoom into folder"; font-size: 12px; color: white; }
                            TouchArea { clicked => { root.zoom-in(); } }
                        }
                        Rectangle {
                            height: 30px;
                            border-radius: 8px;
                            background: Theme.segment-bg;
                            Text { text: "⌂  Back to root"; font-size: 12px; color: Theme.text; }
                            TouchArea { clicked => { root.go-root(); } }
                        }
                        Rectangle {
                            height: 30px;
                            border-radius: 8px;
                            background: Theme.segment-bg;
                            Text { text: "↑  Up one level"; font-size: 12px; color: Theme.text; }
                            TouchArea { clicked => { root.go-up(); } }
                        }
                        Text { text: "CONTENTS"; font-size: 10px; color: Theme.text-dim; }
                        ListView {
                            vertical-stretch: 1;
                            min-height: 40px;
                            for item[i] in root.items: Rectangle {
                                height: 26px;
                                border-radius: 6px;
                                background: row-ta.has-hover ? Theme.segment-bg : transparent;
                                row-ta := TouchArea {
                                    clicked => { root.item-clicked(i); }
                                    changed has-hover => { if self.has-hover { root.item-hovered(i); } }
                                }
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 6px;
                                    Text { text: item.name; font-size: 12px; color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                    Text { text: item.size; font-size: 11px; color: Theme.text-dim; vertical-alignment: center; horizontal-alignment: right; }
                                }
                            }
                        }
                        Text { text: root.total; font-size: 11px; color: Theme.text-dim; }
                    }
                }
                }
            }
            }
        }
    }
}
