import { Palette, ListView } from "std-widgets.slint";

export struct Item { name: string, size: string }
export { Palette, Theme }

// Theme tokens. Auto = follow the system (Palette.color-scheme is the live value).
global Theme {
    in-out property <string> mode: "auto"; // "auto" | "light" | "dark"
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> window-bg: dark ? #1c1c1e : #f5f5f7;
    out property <color> sidebar-bg: dark ? #252528 : #ebebee;
    out property <color> panel-bg: dark ? #2c2c2e : #ffffff;
    out property <color> border: dark ? #3a3a3c : #d8d8dc;
    out property <color> text: dark ? #f2f2f7 : #1d1d1f;
    out property <color> text-dim: dark ? #98989f : #6e6e73;
    out property <color> accent: #0a84ff;
    out property <color> segment-bg: dark ? #3a3a3c : #dcdce0;
}

component Segment inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 26px;
    border-radius: 7px;
    background: active ? Theme.panel-bg : transparent;
    drop-shadow-blur: active ? 2px : 0px;
    drop-shadow-color: #0000002a;
    drop-shadow-offset-y: 1px;
    Text { text: label; font-size: 12px; color: active ? Theme.text : Theme.text-dim; }
    TouchArea { clicked => { root.clicked(); } }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 32px;
    border-radius: 7px;
    background: active ? Theme.accent : (ta.has-hover ? Theme.segment-bg : transparent);
    ta := TouchArea { clicked => { root.clicked(); } }
    Text {
        x: 12px;
        text: label;
        font-size: 13px;
        color: active ? white : Theme.text;
        vertical-alignment: center;
    }
}

export component MainWindow inherits Window {
    title: "Orbit";
    min-width: 760px;
    min-height: 520px;
    preferred-width: 1000px;
    preferred-height: 680px;
    background: Theme.window-bg;
    default-font-family: "Inter";

    in property <image> chart;
    in property <string> status: "Scanning…";
    in property <string> crumb: "/";
    in property <string> sel-name: "";
    in property <string> sel-size: "";
    in property <string> sel-share: "";
    in property <string> sel-files: "";
    in property <string> total: "";
    in property <string> theme-mode: "auto";
    in-out property <string> page: "overview";
    in property <bool> has-selection: false;
    in property <string> sel-title: "HOVER";
    in property <bool> can-zoom: false;
    out property <length> chart-size: min(chart-area.width, chart-area.height);
    in property <[Item]> items;
    callback item-clicked(int);
    callback item-hovered(int);
    callback go-root();
    callback zoom-in();
    callback double-clicked(length, length);

    callback hover(length, length);
    callback clicked(length, length);
    callback go-up();
    callback set-theme(string);
    callback chart-resized();

    HorizontalLayout {
        // Sidebar
        Rectangle {
            width: 210px;
            background: Theme.sidebar-bg;
            VerticalLayout {
                padding: 16px;
                spacing: 4px;
                Text { text: "Orbit"; font-size: 17px; font-weight: 700; color: Theme.text; }
                Rectangle { height: 12px; }
                NavItem { label: "Overview"; active: root.page == "overview"; clicked => { root.page = "overview"; } }
                NavItem { label: "Cleanup"; active: root.page == "cleanup"; clicked => { root.page = "cleanup"; } }
                NavItem { label: "Large files"; active: root.page == "large"; clicked => { root.page = "large"; } }
                Rectangle { vertical-stretch: 1; }
                Text { text: "Appearance"; font-size: 11px; color: Theme.text-dim; }
                Rectangle {
                    height: 30px;
                    border-radius: 9px;
                    background: Theme.segment-bg;
                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        Segment { label: "Auto"; active: root.theme-mode == "auto"; clicked => { root.set-theme("auto"); } }
                        Segment { label: "Light"; active: root.theme-mode == "light"; clicked => { root.set-theme("light"); } }
                        Segment { label: "Dark"; active: root.theme-mode == "dark"; clicked => { root.set-theme("dark"); } }
                    }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }

        // Main
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                Text { text: root.page == "overview" ? "Overview" : (root.page == "cleanup" ? "Cleanup" : "Large files"); font-size: 22px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.status; font-size: 12px; color: Theme.text-dim; vertical-alignment: center; }
            }
            Rectangle {
                vertical-stretch: 1;
                if root.page != "overview": Rectangle {
                background: Theme.panel-bg;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border;
                Text { text: "Coming next"; font-size: 14px; color: Theme.text-dim; }
            }
            row := Rectangle {
                width: parent.width;
                height: parent.height;
                visible: root.page == "overview";
                HorizontalLayout {
                spacing: 12px;
                chart-area := Rectangle {
                    horizontal-stretch: 1;
                    min-width: 200px;
                    min-height: 200px;
                    preferred-width: 200px;
                    preferred-height: 200px;
                    background: Theme.panel-bg;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border;
                    changed width => { root.chart-resized(); }
                    changed height => { root.chart-resized(); }
                    Image {
                        x: (chart-area.width - self.width) / 2;
                        y: (chart-area.height - self.height) / 2;
                        width: root.chart-size - 24px;
                        height: root.chart-size - 24px;
                        source: root.chart;
                        image-fit: contain;
                    }
                    TouchArea {
                        x: (chart-area.width - self.width) / 2;
                        y: (chart-area.height - self.height) / 2;
                        width: root.chart-size - 24px;
                        height: root.chart-size - 24px;
                        moved => { root.hover(self.mouse-x, self.mouse-y); }
                        clicked => { root.clicked(self.mouse-x, self.mouse-y); }
                        double-clicked => { root.double-clicked(self.mouse-x, self.mouse-y); }
                    }
                }
                // Inspector
                Rectangle {
                    width: 230px;
                    background: Theme.panel-bg;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        Text { text: "PATH"; font-size: 10px; color: Theme.text-dim; }
                        Text { text: root.crumb; font-size: 12px; color: Theme.text; wrap: word-wrap; }
                        Rectangle { height: 8px; }
                        Text { text: root.sel-title; font-size: 10px; color: Theme.text-dim; }
                        Text { text: root.sel-name; font-size: 15px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                        Text { text: root.sel-size; font-size: 22px; font-weight: 700; color: Theme.accent; }
                        Text { text: root.sel-share; font-size: 12px; color: Theme.text-dim; }
                        Text { text: root.sel-files; font-size: 12px; color: Theme.text-dim; }
                        Rectangle { height: 8px; }
                        if root.can-zoom: Rectangle {
                            height: 30px;
                            border-radius: 8px;
                            background: Theme.accent;
                            Text { text: "Zoom into folder"; font-size: 12px; color: white; }
                            TouchArea { clicked => { root.zoom-in(); } }
                        }
                        Rectangle {
                            height: 30px;
                            border-radius: 8px;
                            background: Theme.segment-bg;
                            Text { text: "⌂  Back to root"; font-size: 12px; color: Theme.text; }
                            TouchArea { clicked => { root.go-root(); } }
                        }
                        Rectangle {
                            height: 30px;
                            border-radius: 8px;
                            background: Theme.segment-bg;
                            Text { text: "↑  Up one level"; font-size: 12px; color: Theme.text; }
                            TouchArea { clicked => { root.go-up(); } }
                        }
                        Text { text: "CONTENTS"; font-size: 10px; color: Theme.text-dim; }
                        ListView {
                            vertical-stretch: 1;
                            min-height: 40px;
                            for item[i] in root.items: Rectangle {
                                height: 26px;
                                border-radius: 6px;
                                background: row-ta.has-hover ? Theme.segment-bg : transparent;
                                row-ta := TouchArea {
                                    clicked => { root.item-clicked(i); }
                                    changed has-hover => { if self.has-hover { root.item-hovered(i); } }
                                }
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 6px;
                                    Text { text: item.name; font-size: 12px; color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                    Text { text: item.size; font-size: 11px; color: Theme.text-dim; vertical-alignment: center; horizontal-alignment: right; }
                                }
                            }
                        }
                        Text { text: root.total; font-size: 11px; color: Theme.text-dim; }
                    }
                }
                }
            }
            }
        }
    }
}
